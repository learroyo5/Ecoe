DATABASE_URL=postgresql+psycopg://ecoe:ecoe@db:5432/ecoe
ENVIRONMENT=development
AUTO_SEED_DEMO=true
ALLOW_CREATE_ALL_FALLBACK=true
SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=ecoe-backend
JWT_AUDIENCE=ecoe-web
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000,https://ecoe.drnotus.cl
STORAGE_PATH=/app/storage
AUTH_COOKIE_NAME=ecoe_session
AUTH_COOKIE_SAMESITE=lax
ADMIN_PASSWORD=replace-admin-password
COEDITOR_PASSWORD=replace-coeditor-password
EVALUATOR_PASSWORD=replace-evaluator-password
STUDENT_PASSWORD=replace-student-password
COORDINATOR_PASSWORD=replace-coordinator-password
TIMER_PASSWORD=replace-timer-password
