DATABASE_URL=postgresql+psycopg://ecoe:ecoe@db:5432/ecoe
# En el servidor real SIEMPRE production: activa los guard-rails
# (sin seed demo, sin create_all, SECRET_KEY obligatoria, CORS estricto).
ENVIRONMENT=production
AUTO_SEED_DEMO=false
ALLOW_CREATE_ALL_FALLBACK=false
SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=ecoe-backend
JWT_AUDIENCE=ecoe-web
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000,https://ecoe.drnotus.cl
STORAGE_PATH=/app/storage
AUTH_COOKIE_NAME=ecoe_session
AUTH_COOKIE_SAMESITE=lax
ADMIN_PASSWORD=replace-admin-password
COEDITOR_PASSWORD=replace-coeditor-password
EVALUATOR_PASSWORD=replace-evaluator-password
STUDENT_PASSWORD=replace-student-password
COORDINATOR_PASSWORD=replace-coordinator-password
TIMER_PASSWORD=replace-timer-password
# Envio transaccional de invitaciones y reinicio de acceso. Si SMTP_HOST
# queda vacio, el mailer no envia nada y el enlace sigue disponible en la
# respuesta de la API para repartir a mano (comportamiento actual).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PUBLIC_APP_URL=https://ecoe.drnotus.cl
