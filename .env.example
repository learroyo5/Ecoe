# Variables leidas por "docker compose" para interpolar docker-compose.yml
# (distinto de backend/.env, que solo inyecta env vars DENTRO de los
# contenedores backend/frontend). Copiar a ".env" en la raiz del repo.

# Password del usuario "ecoe" en PostgreSQL. Obligatoria: docker-compose.yml
# falla al arrancar si no esta definida (${POSTGRES_PASSWORD:?...}).
# Debe coincidir con la password real de un volumen postgres_data ya
# existente (Postgres no reaplica esta variable sobre datos ya inicializados;
# para rotarla en un servidor con datos, usar ALTER USER ecoe WITH PASSWORD).
POSTGRES_PASSWORD=replace-with-a-strong-password
